{
  "title": "Bilibili Meme Atlas source registry",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "publisher": {
        "type": "string",
        "minLength": 1
      },
      "source_type": {
        "enum": [
          "primary",
          "secondary",
          "community"
        ]
      },
      "access_level": {
        "enum": [
          "full",
          "snippet",
          "metadata"
        ]
      },
      "checked_at": {
        "type": "string",
        "format": "date"
      },
      "supports": {
        "type": "string",
        "minLength": 1
      },
      "limitations": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "title",
      "url",
      "publisher",
      "source_type",
      "access_level",
      "checked_at",
      "supports",
      "limitations"
    ],
    "additionalProperties": false
  }
}
